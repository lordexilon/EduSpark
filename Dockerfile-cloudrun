WORKDIR /app

# Copiar solo archivos necesarios para instalar dependencias
COPY package*.json ./
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY tailwind.config.cjs ./
COPY postcss.config.cjs ./

# Instalar dependencias (incluyendo devDependencies para build)
RUN npm ci

# Copiar código fuente
COPY src ./src
COPY index.html ./
COPY audio-tutor ./audio-tutor
COPY scripts ./scripts

# Build del frontend con las variables de entorno ya configuradas
RUN npm run build

# ========================================
# Stage 2: Nginx para servir archivos estáticos
# ========================================
FROM nginx:alpine AS frontend

# Copiar build del frontend
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Copiar configuración de nginx optimizada para Cloud Run
COPY nginx-cloudrun.conf /etc/nginx/nginx.conf

# Copiar script de inicio
COPY start-nginx.sh /start-nginx.sh
RUN chmod +x /start-nginx.sh

# Exponer puerto (Cloud Run usa PORT variable, por defecto 8080)
EXPOSE 8080

# Usar script de inicio que configura el puerto dinámicamente
CMD ["/start-nginx.sh"]

