{
  "name": "eduspark-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "node scripts/clear-cache.js && npm run dev",
    "dev:emergency": "node scripts/emergency-reload.js && npm run dev",
    "dev:auto": "node scripts/auto-reload.js",
    "dev:worker": "cd src/workers/file-processing-worker && npm run dev",
    "dev:all": "scripts\\start-dev.bat",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clear-cache.js",
    "emergency": "node scripts/emergency-reload.js",
    "test:gemini": "node scripts/test-gemini-api.js",
    "verify:gemini": "node scripts/verify-gemini-api-key.js",
    "process-feedback": "tsx scripts/process-feedback-standalone.ts",
    "process-feedback:course": "tsx scripts/process-feedback-standalone.ts --course-id",
    "deploy:cloudrun": "powershell -ExecutionPolicy Bypass -File scripts/deploy-frontend-cloudrun.ps1",
    "deploy:cloudrun:skip-build": "powershell -ExecutionPolicy Bypass -File scripts/deploy-frontend-cloudrun.ps1 -SkipBuild",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@google/genai": "^1.27.0",
    "@supabase/supabase-js": "^2.75.1",
    "@tiptap/extension-color": "^3.10.1",
    "@tiptap/extension-image": "^3.10.1",
    "@tiptap/extension-link": "^3.10.1",
    "@tiptap/extension-text-align": "^3.10.1",
    "@tiptap/extension-text-style": "^3.10.1",
    "@tiptap/extension-underline": "^3.10.1",
    "@tiptap/react": "^3.10.1",
    "@tiptap/starter-kit": "^3.10.1",
    "dotenv": "^17.2.3",
    "firebase": "^10.13.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^10.2.0",
    "react-router-dom": "6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.18",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
