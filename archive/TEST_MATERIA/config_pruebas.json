{
  "configuracion_pruebas": {
    "materia": {
      "nombre": "MATEMÁTICA PARA LA EMPRESA I",
      "codigo": "MAT-101",
      "creditos": 3,
      "nivel": "introductorio"
    },
    "estructura_curricular": {
      "unidades": [
        {
          "numero": 1,
          "nombre": "EXPRESIONES ALGEBRAICAS",
          "temas": [
            "Conceptos básicos del álgebra",
            "Operaciones con expresiones algebraicas",
            "Factorización",
            "Expresiones algebraicas fraccionarias",
            "Aplicaciones empresariales"
          ]
        },
        {
          "numero": 2,
          "nombre": "ECUACIONES LINEALES – SISTEMAS DE ECUACIONES",
          "temas": [
            "Ecuaciones lineales",
            "Sistemas de ecuaciones lineales",
            "Métodos de resolución",
            "Aplicaciones en problemas empresariales"
          ]
        },
        {
          "numero": 3,
          "nombre": "PROGRESIONES ARITMÉTICAS Y GEOMÉTRICAS",
          "temas": [
            "Progresiones aritméticas",
            "Progresiones geométricas",
            "Fórmulas y aplicaciones",
            "Modelización matemática"
          ]
        },
        {
          "numero": 4,
          "nombre": "TEORÍA DE CONJUNTOS",
          "temas": [
            "Conceptos básicos de conjuntos",
            "Operaciones con conjuntos",
            "Aplicaciones en clasificación",
            "Resolución de problemas"
          ]
        }
      ]
    },
    "configuracion_rag": {
      "modelo_embedding": "text-embedding-004",
      "modelo_generacion": "gemini-2.5-flash",
      "max_chars_por_chunk": 2000,
      "similarity_threshold": 0.7,
      "max_context_chunks": 5
    },
    "configuracion_tutor": {
      "deteccion_intencion": true,
      "analisis_tono": true,
      "respuestas_empaticas": true,
      "contexto_empresarial": true,
      "personalizacion": false
    },
    "casos_prueba": {
      "preguntas_por_categoria": {
        "conceptos_basicos": 5,
        "operaciones_algebraicas": 5,
        "aplicaciones_empresariales": 5,
        "saludo": 3,
        "motivacion": 3,
        "ayuda_general": 3
      },
      "niveles_dificultad": ["basico", "intermedio", "avanzado"],
      "tonos_emocionales": ["curioso", "confundido", "frustrado", "ansioso", "interesado"]
    },
    "metricas_evaluacion": {
      "precision_respuestas": {
        "peso": 0.4,
        "criterios": ["exactitud_matematica", "relevancia_contextual", "claridad_explicacion"]
      },
      "deteccion_intencion": {
        "peso": 0.2,
        "criterios": ["clasificacion_correcta", "confianza_prediccion"]
      },
      "analisis_tono": {
        "peso": 0.2,
        "criterios": ["identificacion_emocional", "adaptacion_respuesta"]
      },
      "experiencia_usuario": {
        "peso": 0.2,
        "criterios": ["tiempo_respuesta", "fluidez_conversacion", "satisfaccion_estudiante"]
      }
    },
    "configuracion_tecnica": {
      "base_datos": {
        "tipo": "PostgreSQL + pgvector",
        "tabla_principal": "course_content_chunks",
        "indices": ["embedding", "course_id", "metadata"]
      },
      "api_endpoints": {
        "webhook_n8n": "https://tu-n8n-instance.com/webhook/tutor-virtual",
        "supabase_url": "https://tu-proyecto.supabase.co",
        "gemini_api": "https://generativelanguage.googleapis.com/v1beta"
      },
      "timeouts": {
        "embedding_generation": 30,
        "rag_query": 15,
        "total_response": 45
      }
    },
    "flujo_pruebas": {
      "fase_1": {
        "nombre": "Preparación de Datos",
        "tareas": [
          "Procesar contenido del curso",
          "Generar embeddings",
          "Cargar datos en Supabase",
          "Configurar n8n workflow"
        ]
      },
      "fase_2": {
        "nombre": "Pruebas Unitarias",
        "tareas": [
          "Probar detección de intención",
          "Probar análisis de tono",
          "Probar generación de embeddings",
          "Probar búsqueda vectorial"
        ]
      },
      "fase_3": {
        "nombre": "Pruebas de Integración",
        "tareas": [
          "Probar flujo completo RAG",
          "Probar respuestas contextuales",
          "Probar respuestas empáticas",
          "Probar casos empresariales"
        ]
      },
      "fase_4": {
        "nombre": "Pruebas de Rendimiento",
        "tareas": [
          "Medir tiempos de respuesta",
          "Probar concurrencia",
          "Optimizar consultas",
          "Validar escalabilidad"
        ]
      }
    },
    "criterios_exito": {
      "precision_respuestas": "> 85%",
      "tiempo_respuesta_promedio": "< 3 segundos",
      "deteccion_intencion": "> 90%",
      "satisfaccion_estudiante": "> 4.0/5.0",
      "disponibilidad_sistema": "> 99%"
    }
  },
  "metadata": {
    "version": "1.0.0",
    "fecha_creacion": "2024-01-01",
    "autor": "EduSpark Team",
    "descripcion": "Configuración para pruebas del Tutor Virtual Inteligente con Matemática para la Empresa I"
  }
}
