    {
      "id": "caso_001",
      "titulo": "Análisis de Costos de Producción",
      "unidad": "unidad_1",
      "descripcion": "Una empresa manufacturera necesita analizar sus costos de producción para optimizar su rentabilidad.",
      "datos": {
        "costos_fijos": 5000,
        "costo_variable_por_unidad": 25,
        "precio_venta_por_unidad": 80,
        "produccion_actual": 100
      },
      "preguntas": [
        "¿Cuál es la expresión algebraica del costo total?",
        "¿Cuál es la expresión de los ingresos?",
        "¿Cuál es la expresión de la utilidad?",
        "¿Cuántas unidades debe producir para alcanzar el punto de equilibrio?"
      ],
      "soluciones": [
        "C(x) = 5000 + 25x",
        "I(x) = 80x", 
        "U(x) = 80x - (5000 + 25x) = 55x - 5000",
        "55x - 5000 = 0, entonces x = 5000/55 ≈ 91 unidades"
      ],
      "conceptos_aplicados": ["expresiones algebraicas", "costos", "ingresos", "utilidad", "punto de equilibrio"]
    },
    {
      "id": "caso_002",
      "titulo": "Optimización de Inventario",
      "unidad": "unidad_2",
      "descripcion": "Una tienda necesita determinar la cantidad óptima de productos a mantener en inventario para minimizar costos.",
      "datos": {
        "costo_almacenamiento_por_unidad": 2,
        "costo_pedido": 50,
        "demanda_mensual": 200,
        "costo_por_unidad": 10
      },
      "preguntas": [
        "¿Cuál es la ecuación del costo total de inventario?",
        "¿Cuál es la cantidad óptima de pedido?",
        "¿Cuál es el costo total mínimo?"
      ],
      "soluciones": [
        "C(x) = (50 * 200)/x + 2x, donde x es la cantidad de pedido",
        "Derivando: C'(x) = -10000/x² + 2 = 0, entonces x = √5000 ≈ 71 unidades",
        "C(71) = 10000/71 + 2(71) ≈ 141 + 142 = 283"
      ],
      "conceptos_aplicados": ["ecuaciones", "optimización", "derivadas", "costos de inventario"]
    },
    {
      "id": "caso_003",
      "titulo": "Crecimiento de Ventas",
      "unidad": "unidad_3",
      "descripcion": "Una empresa quiere proyectar el crecimiento de sus ventas para planificar recursos y estrategias.",
      "datos": {
        "ventas_iniciales": 10000,
        "crecimiento_mensual": 0.05,
        "periodo_proyeccion": 12
      },
      "preguntas": [
        "¿Qué tipo de progresión representa este crecimiento?",
        "¿Cuál será el volumen de ventas en el mes 12?",
        "¿Cuál es el total de ventas acumuladas en 12 meses?"
      ],
      "soluciones": [
        "Progresión geométrica con razón r = 1.05",
        "V12 = 10000 × (1.05)^11 ≈ 10000 × 1.71 = 17,100",
        "Suma = 10000 × ((1.05)^12 - 1)/(1.05 - 1) ≈ 10000 × 0.80/0.05 = 160,000"
      ],
      "conceptos_aplicados": ["progresión geométrica", "crecimiento exponencial", "suma de progresión"]
    },
    {
      "id": "caso_004",
      "titulo": "Segmentación de Clientes",
      "unidad": "unidad_4",
      "descripcion": "Una empresa de servicios necesita clasificar sus clientes para diseñar estrategias de marketing personalizadas.",
      "datos": {
        "total_clientes": 1000,
        "clientes_premium": 200,
        "clientes_frecuentes": 300,
        "clientes_premium_y_frecuentes": 100
      },
      "preguntas": [
        "¿Cuántos clientes son premium pero no frecuentes?",
        "¿Cuántos clientes son frecuentes pero no premium?",
        "¿Cuántos clientes son premium o frecuentes?",
        "¿Cuántos clientes no son ni premium ni frecuentes?"
      ],
      "soluciones": [
        "Premium no frecuentes: 200 - 100 = 100",
        "Frecuentes no premium: 300 - 100 = 200", 
        "Premium o frecuentes: 200 + 300 - 100 = 400",
        "Ni premium ni frecuentes: 1000 - 400 = 600"
      ],
      "conceptos_aplicados": ["conjuntos", "intersección", "unión", "complemento", "diagramas de Venn"]
    },
    {
      "id": "caso_005",
      "titulo": "Análisis de Rentabilidad por Producto",
      "unidad": "unidad_1",
      "descripcion": "Una empresa tiene múltiples productos y necesita determinar cuáles son más rentables para enfocar sus recursos.",
      "datos": {
        "producto_a": {
          "precio": 50,
          "costo_variable": 30,
          "costo_fijo_asignado": 1000
        },
        "producto_b": {
          "precio": 80,
          "costo_variable": 40,
          "costo_fijo_asignado": 1500
        }
      },
      "preguntas": [
        "¿Cuál es la expresión de utilidad para cada producto?",
        "¿Cuál es el punto de equilibrio para cada producto?",
        "¿Cuál producto es más rentable con ventas de 100 unidades?"
      ],
      "soluciones": [
        "Producto A: U(x) = 50x - (30x + 1000) = 20x - 1000",
        "Producto B: U(x) = 80x - (40x + 1500) = 40x - 1500",
        "Punto equilibrio A: 20x - 1000 = 0, x = 50 unidades",
        "Punto equilibrio B: 40x - 1500 = 0, x = 37.5 unidades",
        "Con 100 unidades: A = 20(100) - 1000 = 1000, B = 40(100) - 1500 = 2500"
      ],
      "conceptos_aplicados": ["expresiones algebraicas", "utilidad", "punto de equilibrio", "comparación de rentabilidad"]
    }
