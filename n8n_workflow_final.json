    {
      "parameters": {
        "jsCode": "function extractJson(text){if(typeof text!==\"string\") return \"{}\"; const m=text.match(/```json\\s*([\\s\\S]*?)```/i); return (m?m[1]:text).trim();}\nfunction safeParse(s,fb={}){try{return JSON.parse(extractJson(s));}catch{return fb;}}\n\nconst arr = $items('Join Intent+Tone')||[];\nlet intentObj=null, toneObj=null;\nfor(const it of arr){\n  const txt = it?.json?.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  const obj = safeParse(txt, {});\n  if ('intencion' in obj || 'tema' in obj) intentObj=obj;\n  if ('tono' in obj) toneObj=obj;\n}\nintentObj = intentObj || { intencion: 'otro', tema: 'general' };\ntoneObj   = toneObj   || { tono: 'empatico' };\n\nreturn [{ json: { intencion:intentObj.intencion||'otro', tema:String(intentObj.tema||'general'), tono:toneObj.tono||'empatico' } }];"
      },
