        "jsCode": "// Extrae el texto principal de la respuesta de Gemini\nconst answer =\n  $json?.candidates?.[0]?.content?.parts?.[0]?.text?.trim() ||\n  \"No encuentro esa información en el material del curso.\";\n\n// Opcional: si quieres limitar longitud (por si Gemini se extiende demasiado)\nconst trimmedAnswer = answer.slice(0, 1500);\n\n// Formato limpio de salida\nreturn [\n  {\n    json: {\n      success: true,\n      message: trimmedAnswer,\n      metadata: {\n        model: \"gemini-2.5-flash\",\n        source: \"Tutor Virtual AI\",\n        contextUsed: $items(\"Format Context\")?.[0]?.json?.context?.slice(0, 300) || \"Sin contexto usado\",\n        timestamp: new Date().toISOString(),\n      },\n    },\n  },\n];\n"
