{
  "name": "confirm-user-email",
  "version": "1.0.0",
  "description": "Cloud Function para confirmar/activar email de usuarios (requiere admin)",
  "main": "lib/index.js",
  "scripts": {
    "start": "functions-framework --target=confirmUserEmail --signature-type=http",
    "deploy": "firebase deploy --only functions:confirmUserEmail"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.0.0",
    "@supabase/supabase-js": "^2.75.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}