{
    "name": "rag-worker",
    "version": "1.0.0",
    "description": "RAG Processing Worker as Cloud Function",
    "main": "index.js",
    "scripts": {
        "deploy": "gcloud functions deploy rag-worker --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=processRagJobs --trigger-http --allow-unauthenticated --timeout=3600s --memory=4GB --max-instances=10"
    },
    "dependencies": {
        "@google-cloud/functions-framework": "^3.3.0",
        "@supabase/supabase-js": "^2.39.0",
        "@google/generative-ai": "^0.1.3",
        "pdf-parse": "^1.1.1",
        "pdf-lib": "^1.17.1",
        "axios": "^1.6.0",
        "express": "^4.18.2"
    }
}